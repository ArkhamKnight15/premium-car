# Configuração para hospedagens Apache (HostGator, Hostinger etc.). Ignorado pela Vercel.

# Sempre HTTPS e sem "www" (https://premiumcarrj.com.br)
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://premiumcarrj.com.br%{REQUEST_URI} [L,R=301]

# Compressão de texto
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

# Cache: arquivos com hash em /assets nunca mudam; a página sempre é revalidada
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(png|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
